MONGODB_URL=mongodb+srv://...
DB_NAME=pingme
JWT_SECRET=your_secret_key
JWT_EXPIRE_HOURS=24
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=10
SCHEDULER_PROVIDER=apscheduler
AWS_REGION=ap-south-1
AWS_SCHEDULER_GROUP=default
AWS_SCHEDULER_ROLE_ARN=arn:aws:iam::123456789012:role/pingme-scheduler-role
AWS_REMINDER_TARGET_ARN=arn:aws:lambda:ap-south-1:123456789012:function:pingme-backend
# Keep this true for local/dev servers. Lambda deployments should not rely on the
# in-process scheduler; reminder execution will move to EventBridge.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_username
SMTP_PASSWORD=your_brevo_smtp_password
SMTP_FROM_EMAIL=your_verified_sender@example.com
ALLOW_CONSOLE_EMAIL_FALLBACK=true
GEMINI_API_KEY=your_gemini_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
